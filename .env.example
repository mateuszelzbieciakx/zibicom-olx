# Skopiuj do .env i uzupelnij (lokalny development na Windowsie).
# W Dockerze te same wartosci przychodza z /run/secrets - patrz README.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zibicom
POSTGRES_USER=zibicom
POSTGRES_PASSWORD=zmien-mnie

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Miasto OLX dla publikowanych ofert - 0 dopoki nie ustalisz go przez
# GET /api/olx/cities. Kategoria NIE jest tu ustawiana - zalezy od
# producenta platformy (platform.olx_category_id, migracja 0005).
OLX_CITY_ID=0

# Nazwa kontaktowa wyswietlana w ogloszeniu (pole "contact.name" wymagane
# przez OLX Partner API).
OLX_CONTACT_NAME=ZibiCom
