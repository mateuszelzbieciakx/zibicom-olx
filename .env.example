# Skopiuj do .env i uzupelnij (lokalny development na Windowsie).
# W Dockerze te same wartosci przychodza z /run/secrets - patrz README.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zibicom
POSTGRES_USER=zibicom
POSTGRES_PASSWORD=zmien-mnie

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Kategoria i miasto OLX dla publikowanych ofert - 0 dopoki nie ustalisz ich
# przez GET /api/olx/categories i /api/olx/cities.
OLX_CATEGORY_ID=0
OLX_CITY_ID=0
